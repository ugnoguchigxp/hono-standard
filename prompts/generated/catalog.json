    "chat.search-decision": {
      "key": "chat.search-decision",
      "owner": "rag-platform",
      "contentKind": "text",
      "messageRole": "system",
      "sourceLocale": "ja-JP",
      "requiredLocales": [
        "ja-JP",
        "en-US"
      ],
      "variables": {},
      "locales": {
        "en-US": {
          "sections": [
            {
              "id": "context.text",
              "kind": "instruction",
              "severity": "must",
              "optimizable": false,
              "omitIfEmpty": false,
              "segments": [
                {
                  "type": "literal",
                  "value": "Decide whether search is required before answering.\nDo not search by default.\nIf general knowledge is sufficient, return JSON with shouldSearch=false and a complete Markdown answer.\nSearch is required for local workspace, wiki, or project-specific facts; current or time-sensitive facts; explicit search requests; citation requests; or uncertainty.\nWhen search is required, choose one concise searchQuery. The same query is used for full-text and vector search.\nReturn only one of these JSON objects: {\"shouldSearch\":false,\"answer\":\"...\"} or {\"shouldSearch\":true,\"searchQuery\":\"...\"}"
                }
              ]
            }
          ],
          "artifactHash": "sha256:89a79cc4178cdef29379b7a28b14e185d1031f0f1dcb445b29eb2df98e3450c7"
        },
        "ja-JP": {
          "sections": [
            {
              "id": "context.text",
              "kind": "instruction",
              "severity": "must",
              "optimizable": false,
              "omitIfEmpty": false,
              "segments": [
                {
                  "type": "literal",
                  "value": "回答前に検索が必要か判断してください。\n既定では検索しないでください。\n一般知識だけで十分に回答できる場合は、shouldSearch=false と完全な Markdown 回答を含む JSON を返してください。\nローカルの workspace・wiki・プロジェクト固有情報、現在または時点依存の情報、明示的な検索要求、引用要求、確信がない場合は検索が必要です。\n検索が必要な場合は、簡潔な searchQuery を1つ選んでください。同じクエリを全文検索とベクトル検索に使用します。\n次のいずれかの JSON だけを返してください: {\"shouldSearch\":false,\"answer\":\"...\"} または {\"shouldSearch\":true,\"searchQuery\":\"...\"}"
                }
              ]
            }
          ],
          "artifactHash": "sha256:61149511ca7000d2512ad3d17053158d8c9bf4607b1a6f08ba7fa6e1367e951a"
        }
      },
