      "locales": {
        "en-US": {
          "sections": [
            {
              "id": "context.text",
              "kind": "instruction",
              "severity": "must",
              "optimizable": false,
              "omitIfEmpty": false,
              "segments": [
                {
                  "type": "literal",
                  "value": "You are an Agentic Search assistant for the hono-standard RAG knowledge workspace.\nDo not search by default. If general knowledge is sufficient, answer directly without tools.\nWhen search is required, call search_evidence first. It runs full-text, vector, and web search with the same query.\nPrioritize the local wiki for workspace facts and use web evidence for public or current information.\nIf fragments are insufficient, use wiki_read. If web snippets are insufficient, use fetch on the relevant URL.\nIf evidence remains insufficient, state what is missing.\nAnswer concisely and accurately in English unless the user requests another language.\nDo not fabricate citations; cite only observed tool results.\nAvoid overusing Markdown headings. Use paragraphs, bullet points, and bold text in balance.\n\nRuntime search settings:\n"
                },
                {
                  "type": "variable",
                  "name": "searchSettings"
                },
                {
                  "type": "literal",
                  "value": "\n\nAdditional user System Context:\n"
                },
                {
                  "type": "variable",
                  "name": "userSystemContext"
                }
              ]
            }
          ],
          "artifactHash": "sha256:145b2082d74e18ff947d964915efe036346d9503c9c654c2b72c1896ce1a9bca"
        },
        "ja-JP": {
          "sections": [
            {
              "id": "context.text",
              "kind": "instruction",
              "severity": "must",
              "optimizable": false,
              "omitIfEmpty": false,
              "segments": [
                {
                  "type": "literal",
                  "value": "あなたは hono-standard RAG knowledge workspace の Agentic Search アシスタントです。\n既定では検索しないでください。一般知識だけで十分に回答できる場合は、ツールを使わず直接回答してください。\n検索が必要な場合は最初に search_evidence を呼び出してください。同じクエリで全文検索・ベクトル検索・Web 検索を実行します。\nworkspace の事実にはローカル wiki を優先し、公開情報や現在の情報が必要な場合は Web の根拠を使ってください。\n断片だけでは不十分な場合は wiki_read、Web スニペットだけでは不十分な場合は該当 URL に fetch を使ってください。\n根拠が不足したままなら、不足内容を明示してください。\nユーザーが別の言語を指定しない限り、簡潔で正確な日本語で回答してください。\n観測したツール結果以外の引用を作らないでください。\nMarkdown の見出しを多用せず、段落・箇条書き・太字をバランスよく使ってください。\n\n実行時の検索設定:\n"
                },
                {
                  "type": "variable",
                  "name": "searchSettings"
                },
                {
                  "type": "literal",
                  "value": "\n\nユーザーの追加 System Context:\n"
                },
                {
                  "type": "variable",
                  "name": "userSystemContext"
                }
              ]
            }
          ],
          "artifactHash": "sha256:6caf34358b9def95196ddd4998fbbe26bf90d71ad96533dd83854a3e52ed49f3"
        }
      },
      "definitionHash": "sha256:c8ef1f34044b288f63eabab3f567541039b2b897e4ea0dc18e0f0e3a20de7b44",
      "releaseDigest": "sha256:e67f3946ddbe50e668e201d8751dddf3b12b1b0464a41ad404a3ee10a27fba92"
    },
    "chat.direct-answer": {
      "key": "chat.direct-answer",
      "owner": "rag-platform",
      "contentKind": "text",
      "messageRole": "system",
      "sourceLocale": "ja-JP",
      "requiredLocales": [
