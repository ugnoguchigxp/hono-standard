{
  "name": "hono-standard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "designSystem"
  ],
  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run --cwd designSystem build && vite build",
    "build:backend": "bun build --target=bun --packages=external --format=esm --outfile=dist-api/index.js api/index.ts",
    "start": "NODE_ENV=production bun dist-api/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:all": "biome check .",
    "format:check": "biome format .",
    "design-system:storybook": "bun run --cwd designSystem storybook",
    "design-system:storybook:build": "bun run --cwd designSystem build-storybook",
    "design-system:sync": "tsx scripts/sync-design-system.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:regression": "playwright test --grep @regression",
    "format": "biome format --write .",
    "verify": "bun scripts/verify.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.4",
    "@repo/design-system": "workspace:*",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-router": "^1.168.10",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-html": "^2.17.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@hono/vite-dev-server": "^0.25.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/bun": "^1.3.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "msw": "^2.12.14",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
